# Copy these into Railway → Variables (web service).
# Do NOT commit real secrets. Copy database.env.example to database.env and paste
# DATABASE_URL from the Postgres plugin (comments in database.env are ignored).

APP_NAME="Orbit CRM"
APP_ENV=production
APP_DEBUG=false
# MUST match local .env APP_KEY if you migrate/sync encrypted company secrets
# (lead API keys, Calendly tokens, Multilogin tokens). Otherwise re-enter secrets
# in Companies → Edit, or run: php scripts/sync-company-secrets-to-railway.php
# Generate with: php artisan key:generate --show
APP_KEY=base64:REPLACE_ME
APP_URL=https://YOUR-APP.up.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
# Prefer Railway reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
DB_SSLMODE=require

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

CONTAINER_ROLE=web
PORT=8080

# --- Scheduler service (same image) ---
# Duplicate the web service on Railway and set only:
# CONTAINER_ROLE=scheduler
# (no public domain needed)

# Multilogin / Calendly / company API keys live encrypted in the DB
# (integration_settings / companies). Migrating local data brings them over
# only if Railway APP_KEY matches the key used when they were encrypted.
# If APP_KEY changes, re-enter secrets in Companies → Edit (and Settings).
